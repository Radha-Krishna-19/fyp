% ---- THE MULTIFRACTAL METHOD WE IMPLEMENT ---------------------------------
@article{xiao2021nmfa,
  author  = {Xiao, Jian and Wang, Bo and Li, Xiang},
  title   = {Deciphering the Generating Rules and Functionalities of Complex Networks},
  journal = {Scientific Reports},
  volume  = {11}, pages = {22964}, year = {2021},
  doi     = {10.1038/s41598-021-02203-4},
  note    = {Source of NMFA and iNMFA. Defines the partition function
