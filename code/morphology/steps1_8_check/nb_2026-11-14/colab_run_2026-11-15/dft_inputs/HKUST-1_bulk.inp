&GLOBAL
  PROJECT HKUST-1_bulk
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    UKS .TRUE.
    MULTIPLICITY 13
    &MGRID
      CUTOFF 500
      REL_CUTOFF 50
    &END MGRID
